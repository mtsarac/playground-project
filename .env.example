# Database — Neon (or any PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session secret — min 32 characters, generate with: openssl rand -hex 32
SESSION_SECRET="your-secret-key-at-least-32-characters-long"

# Set to "true" when using Neon / Supabase / any SSL-required Postgres
DB_SSL="true"
